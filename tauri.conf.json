{
  "productName": "t3-import",
  "identifier": "io.github.paulomanrique.t3import",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "t3-import",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  }
}
